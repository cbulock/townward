{
  "name": "openpolis",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:run": "bun scripts/sim-run.ts",
    "bench": "bun run sim:run --scenario demo --years 1 --budget",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:native": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/vite/bin/vite.js build --mode native",
    "android:sync": "bun run build:native && bun node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-debug.ps1",
    "test:android": "bun node_modules/vitest/vitest.mjs run tests/android-platform.test.ts tests/input.test.ts tests/app-lifecycle.test.ts tests/touch-plans.test.ts tests/native-api.test.ts tests/native-http-bridge.test.ts tests/native-cloud-backup.test.ts --maxWorkers=2",
    "test:android:browser": "bun node_modules/@playwright/test/cli.js test -c playwright.android.config.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jotai": "^3.0.1",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1"
  }
}
